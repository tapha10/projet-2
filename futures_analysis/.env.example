# Copiez ce fichier en .env et remplissez votre clé API Anthropic.
# La clé peut aussi être exportée directement dans votre shell/crontab.
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle à utiliser (défaut : claude-opus-5).
# claude-sonnet-5 ou claude-haiku-4-5 réduisent le coût si l'usage quotidien
# devient significatif.
CLAUDE_MODEL=claude-opus-5

# Optionnel : niveau d'effort du modèle (low/medium/high/xhigh/max, défaut: medium)
CLAUDE_EFFORT=medium
